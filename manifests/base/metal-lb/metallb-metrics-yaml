# metallb-values.yaml

# Enable metrics for the controller and speaker components
controller:
  # Resource limits for MetalLB controller
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi
  metrics:
    enabled: true
    serviceMonitor:
      # Set this to false as we want to use PodMonitor instead
      enabled: false
    podMonitor:
      # Enable the PodMonitor resource creation by the Helm chart
      enabled: true

speaker:
  # Resource limits for MetalLB speaker (runs on each node)
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi
  frr:
    resources:
      requests:
        cpu: 5m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 64Mi
  reloader:
    resources:
      requests:
        cpu: 1m
        memory: 8Mi
      limits:
        cpu: 25m
        memory: 32Mi
  frrMetrics:
    resources:
      requests:
        cpu: 5m
        memory: 16Mi
      limits:
        cpu: 50m
        memory: 32Mi
  initContainers:
    cpFrrFiles:
      resources:
        requests:
          cpu: 1m
          memory: 8Mi
        limits:
          cpu: 25m
          memory: 32Mi
    cpReloader:
      resources:
        requests:
          cpu: 1m
          memory: 8Mi
        limits:
          cpu: 25m
          memory: 32Mi
    cpMetrics:
      resources:
        requests:
          cpu: 1m
          memory: 8Mi
        limits:
          cpu: 25m
          memory: 32Mi
  metrics:
    enabled: true
    serviceMonitor:
      # Set this to false as we want to use PodMonitor instead
      enabled: false
    podMonitor:
      # Enable the PodMonitor resource creation by the Helm chart
      enabled: true

# Disable frr-k8s backend — cluster uses L2 mode only (no BGP).
# frr-k8s DaemonSet has init containers with no chart-level resource config,
# which would be blocked by Gatekeeper require-resource-limits.
frrk8s:
  enabled: false

prometheus:
  podMonitors:
    enabled: true
