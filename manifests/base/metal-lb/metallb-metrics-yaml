# metallb-values.yaml

controller:
  # Resource limits for MetalLB controller
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi

speaker:
  # Resource limits for MetalLB speaker (runs on each node)
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi
  frr:
    resources:
      requests:
        cpu: 5m
        memory: 32Mi
      limits:
        cpu: 100m
        memory: 64Mi
  reloader:
    resources:
      requests:
        cpu: 1m
        memory: 8Mi
      limits:
        cpu: 25m
        memory: 32Mi
  frrMetrics:
    resources:
      requests:
        cpu: 5m
        memory: 16Mi
      limits:
        cpu: 50m
        memory: 32Mi
  initContainers:
    cpFrrFiles:
      resources:
        requests:
          cpu: 1m
          memory: 8Mi
        limits:
          cpu: 25m
          memory: 32Mi
    cpReloader:
      resources:
        requests:
          cpu: 1m
          memory: 8Mi
        limits:
          cpu: 25m
          memory: 32Mi
    cpMetrics:
      resources:
        requests:
          cpu: 1m
          memory: 8Mi
        limits:
          cpu: 25m
          memory: 32Mi

# Disable frr-k8s backend — cluster uses L2 mode only (no BGP).
# frr-k8s DaemonSet has init containers with no chart-level resource config,
# which would be blocked by Gatekeeper require-resource-limits.
frrk8s:
  enabled: false

# Monitoring. The chart only reads these keys under `prometheus:` — the
# `controller.metrics` / `speaker.metrics` / `prometheus.podMonitors` blocks
# that used to be here are not chart values and were silently ignored, so
# MetalLB went unscraped until 2026-11-15.
#
# Metrics are HTTPS on 9120 and need a bearer token: the chart creates the
# metallb-metrics-token Secret, and rbacPrometheus grants the Prometheus
# service account below what it needs.
prometheus:
  serviceAccount: kube-prometheus-stack-prometheus
  namespace: default
  podMonitor:
    enabled: true
    additionalLabels:
      release: kube-prometheus-stack
  prometheusRule:
    enabled: true
    additionalLabels:
      release: kube-prometheus-stack
    # L2 mode only — there are no BGP sessions to watch.
    bgpSessionDown:
      enabled: false
