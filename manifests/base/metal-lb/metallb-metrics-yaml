# metallb-values.yaml

# Enable metrics for the controller and speaker components
controller:
  # Resource limits for MetalLB controller
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi
  metrics:
    enabled: true
    serviceMonitor:
      # Set this to false as we want to use PodMonitor instead
      enabled: false
    podMonitor:
      # Enable the PodMonitor resource creation by the Helm chart
      enabled: true

speaker:
  # Resource limits for MetalLB speaker (runs on each node)
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi
  metrics:
    enabled: true
    serviceMonitor:
      # Set this to false as we want to use PodMonitor instead
      enabled: false
    podMonitor:
      # Enable the PodMonitor resource creation by the Helm chart
      enabled: true

prometheus:
  podMonitors:
    enabled: true
