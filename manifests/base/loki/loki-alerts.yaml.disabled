apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: loki-log-based-alerts
  namespace: loki
  labels:
    prometheus: kube-prometheus
    role: alert-rules
    app: loki
spec:
  groups:
    - name: loki.log_errors
      interval: 1m
      rules:
        - alert: HighErrorLogRate
          expr: |
            sum by (namespace, pod) (
              rate({namespace=~".+"} |~ "(?i)(error|err|fatal|exception|panic|fail)" [5m])
            ) > 1
          for: 5m
          labels:
            severity: warning
            component: loki
            alert_type: log_pattern
          annotations:
            summary: "High error log rate detected in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} is logging errors at {{ $value | humanize }} per second for the last 5 minutes."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/high-error-logs.md"

        - alert: CriticalErrorLogs
          expr: |
            sum by (namespace, pod) (
              rate({namespace=~".+"} |~ "(?i)(critical|fatal|panic|emergency)" [5m])
            ) > 0.1
          for: 2m
          labels:
            severity: critical
            component: loki
            alert_type: log_pattern
          annotations:
            summary: "Critical errors detected in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} is logging critical/fatal errors at {{ $value | humanize }} per second."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/critical-error-logs.md"

    - name: loki.pod_failures
      interval: 1m
      rules:
        - alert: CrashLoopBackOffDetected
          expr: |
            sum by (namespace, pod) (
              rate({namespace=~".+"} |~ "(?i)(back-off restarting failed container|crashloopbackoff)" [5m])
            ) > 0
          for: 5m
          labels:
            severity: critical
            component: loki
            alert_type: pod_failure
          annotations:
            summary: "CrashLoopBackOff detected in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} is in CrashLoopBackOff state."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/crashloopbackoff.md"

        - alert: OOMKilledDetected
          expr: |
            sum by (namespace, pod) (
              rate({namespace=~".+"} |~ "(?i)(oomkilled|out of memory|memory cgroup out of memory)" [5m])
            ) > 0
          for: 1m
          labels:
            severity: critical
            component: loki
            alert_type: pod_failure
          annotations:
            summary: "OOMKilled event detected in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} was killed due to out of memory."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/oomkilled.md"

        - alert: PersistentPodRestarts
          expr: |
            count_over_time({namespace=~".+"} |~ "(?i)(restarting container|restart count)" [15m]) > 5
          for: 10m
          labels:
            severity: warning
            component: loki
            alert_type: pod_failure
          annotations:
            summary: "Persistent pod restarts in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} has restarted multiple times in the last 15 minutes."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/persistent-restarts.md"

    - name: loki.application_errors
      interval: 1m
      rules:
        - alert: HighHTTP5xxErrorRate
          expr: |
            sum by (namespace, pod) (
              rate({namespace=~".+"} |~ "(?i)(status[= :]5[0-9]{2}|http.*5[0-9]{2})" [5m])
            ) > 1
          for: 5m
          labels:
            severity: warning
            component: loki
            alert_type: application_error
          annotations:
            summary: "High HTTP 5xx error rate in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} is returning HTTP 5xx errors at {{ $value | humanize }} per second."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/http-5xx-errors.md"

        - alert: DatabaseConnectionErrors
          expr: |
            sum by (namespace, pod) (
              rate({namespace=~".+"} |~ "(?i)(connection.*refused|connection.*timeout|database.*error|sql.*error)" [5m])
            ) > 0.5
          for: 5m
          labels:
            severity: warning
            component: loki
            alert_type: application_error
          annotations:
            summary: "Database connection errors in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} is experiencing database connection errors."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/database-errors.md"

    - name: loki.security_events
      interval: 1m
      rules:
        - alert: AuthenticationFailures
          expr: |
            sum by (namespace, pod) (
              rate({namespace=~".+"} |~ "(?i)(authentication.*failed|auth.*failed|unauthorized|invalid.*credentials)" [5m])
            ) > 5
          for: 5m
          labels:
            severity: warning
            component: loki
            alert_type: security
          annotations:
            summary: "High authentication failure rate in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} is experiencing {{ $value | humanize }} authentication failures per second."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/auth-failures.md"

        - alert: SuspiciousActivity
          expr: |
            sum by (namespace, pod) (
              rate({namespace=~".+"} |~ "(?i)(attack|intrusion|exploit|malicious|suspicious)" [5m])
            ) > 0
          for: 2m
          labels:
            severity: critical
            component: loki
            alert_type: security
          annotations:
            summary: "Suspicious activity detected in {{ $labels.namespace }}/{{ $labels.pod }}"
            description: "Pod {{ $labels.pod }} in namespace {{ $labels.namespace }} has logs indicating potential security concerns."
            runbook_url: "https://github.com/imcbeth/homelab/blob/main/docs/runbooks/suspicious-activity.md"
