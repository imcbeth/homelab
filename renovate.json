{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separatePatchReleases"
  ],
  "timezone": "America/Edmonton",
  "schedule": [
    "after 6am and before 9pm on saturday and sunday"
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "assignees": [
    "imcbeth"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/manifests/applications/.*\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Group ArgoCD ecosystem updates",
      "groupName": "ArgoCD ecosystem",
      "labels": [
        "dependencies",
        "renovate",
        "argocd"
      ],
      "matchPackageNames": [
        "/^argo/"
      ]
    },
    {
      "description": "argo-events on its own, outside the weekend batch. v1.9.11 carries 4 CRITICAL CVEs in vendored Go dependencies (stdlib, grpc, pgx x2) with no fixed release available as of 2026-09-11 \u2014 scanning the 31 Aug `latest` rebuild confirmed it fixes none of them and adds one. The fix can only come from upstream, so the release should surface the day it ships rather than waiting up to a week. Placed AFTER the ArgoCD ecosystem rule so it overrides the grouping, and BEFORE the major-update rule so major bumps are still held for review. vulnerabilityAlerts does not cover this: it keys off GitHub advisories for the chart, which will not fire for CVEs vendored inside the container image.",
      "matchPackageNames": [
        "argo-events"
      ],
      "groupName": "argo-events",
      "schedule": [
        "at any time"
      ],
      "prPriority": 5
    },
    {
      "description": "Group monitoring stack updates",
      "matchPackageNames": [
        "kube-prometheus-stack",
        "loki",
        "alloy"
      ],
      "groupName": "Monitoring stack",
      "labels": [
        "dependencies",
        "renovate",
        "monitoring"
      ]
    },
    {
      "description": "Group security tools updates",
      "matchPackageNames": [
        "trivy-operator",
        "sealed-secrets"
      ],
      "groupName": "Security tools",
      "labels": [
        "dependencies",
        "renovate",
        "security"
      ]
    },
    {
      "description": "Group networking updates",
      "matchPackageNames": [
        "metallb",
        "cert-manager",
        "external-dns",
        "pihole"
      ],
      "groupName": "Networking",
      "labels": [
        "dependencies",
        "renovate",
        "networking"
      ]
    },
    {
      "description": "Group backup tools updates",
      "matchPackageNames": [
        "velero"
      ],
      "groupName": "Backup tools",
      "labels": [
        "dependencies",
        "renovate",
        "backup"
      ]
    },
    {
      "description": "localstack/localstack is in ignoreDeps for a hard reason, not out of neglect: 4.14.0 is the LAST release that runs without a licence. From 2026.03.0 LocalStack merged the Community and Pro images into one, and without LOCALSTACK_AUTH_TOKEN the container exits 55 at startup. Bumping it to 2026.10.4 on 2026-10-29 took the service down and had to be rolled back. The pin therefore carries 24 CRITICAL / 179 HIGH unpatchable CVEs, which is a known accepted risk on a LAN-only dev emulator, NOT something a Renovate PR can fix. Escaping it means getting a free Hobby auth token or replacing LocalStack altogether.",
      "matchPackageNames": [
        "localstack/localstack"
      ],
      "labels": [
        "dependencies",
        "renovate",
        "localstack"
      ]
    },
    {
      "description": "Automerge patch updates for non-critical tools",
      "matchPackageNames": [
        "metrics-server",
        "localstack/localstack"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": false,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Hold major updates for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "renovate",
        "major-update"
      ],
      "prPriority": -1
    },
    {
      "description": "The generic image manager also extracts these under their pull-through registry.k8s.n37.ca names, which Renovate cannot look up (it queries our private Zot, not upstream) and which produced 'no-result' dashboard warnings. Disable those names; the dedicated customManagers extract the same images under their real upstream names instead.",
      "matchPackageNames": [
        "registry.k8s.n37.ca/external-dns/external-dns",
        "registry.k8s.n37.ca/kashalls/external-dns-unifi-webhook"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker image tags in Kubernetes manifests",
      "managerFilePatterns": [
        "/manifests/base/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*['\"]?(?<depName>[^:@\\s'\"]+):(?<currentValue>[^@\\s'\"]+)['\"]?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update external-snapshotter refs in kustomization",
      "managerFilePatterns": [
        "/manifests/base/.*/kustomization\\.ya?ml$/"
      ],
      "matchStrings": [
        "github\\.com/kubernetes-csi/external-snapshotter/[^?]+\\?ref=(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "kubernetes-csi/external-snapshotter",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "external-dns via the pull-through registry; resolved to its upstream name",
      "managerFilePatterns": [
        "/^manifests/base/external-dns/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*[\"']?registry\\.k8s\\.n37\\.ca/external-dns/external-dns:(?<currentValue>[^@\\s\"']+)"
      ],
      "depNameTemplate": "registry.k8s.io/external-dns/external-dns",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "unifi webhook via the pull-through registry; resolved to its upstream name",
      "managerFilePatterns": [
        "/^manifests/base/external-dns/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*[\"']?registry\\.k8s\\.n37\\.ca/kashalls/external-dns-unifi-webhook:(?<currentValue>[^@\\s\"']+)"
      ],
      "depNameTemplate": "ghcr.io/kashalls/external-dns-unifi-webhook",
      "datasourceTemplate": "docker"
    }
  ],
  "ignoreDeps": [
    "synology-csi",
    "synology/synology-csi",
    "registry.k8s.io/ingress-nginx/kube-webhook-certgen",
    "golift/unifi-poller",
    "velero/velero-plugin-for-aws",
    "localstack/localstack",
    "registry.k8s.n37.ca/flink-demo",
    "registry.k8s.n37.ca/lifeonabike/lifeonabike.ca"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "vulnerability"
    ]
  }
}
